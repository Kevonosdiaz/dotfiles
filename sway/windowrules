# Adjust window rules for specific applications
for_window [app_id="pavucontrol-qt"] floating enable
for_window [app_id="pavucontrol-qt"] resize set 720 960
for_window [app_id="pavucontrol-qt"] opacity 0.95
for_window [app_id="pop-up"] floating enable
for_window [app_id="bubble"] floating enable
for_window [app_id="float"] floating enable
for_window [app_id="float"] resize set 960 600
for_window [app_id="float"] opacity 0.95

# for_window [app_id="steam"] floating enable
for_window [class="feh"] floating enable

# Prevent swayidle from triggering when fullscreening anything or gamescope is focused
for_window [class=".*"] inhibit_idle fullscreen
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class="gamescope"] inhibit_idle focus
